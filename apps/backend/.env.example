# Local development only. Replace credentials and the signing secret before use.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sponscrm
JWT_SECRET=replace-with-a-long-random-signing-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
PORT=3000
NODE_ENV=development

# Optional: Google sign-in (public web OAuth client ID; no secret needed).
# Must match VITE_GOOGLE_SIGN_IN_CLIENT_ID in the frontend.
GOOGLE_SIGN_IN_CLIENT_ID=

# Optional: Google Sheets integration (separate from sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/google/callback
